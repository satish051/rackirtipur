            }
        };

        const ecoModal = document.getElementById('club-modal');
        const ecoModalContent = document.getElementById('club-modal-content');

        function openClubModal(clubId) {
            const data = clubData[clubId];
            if (!data) return;

            // Define color classes based on the club's theme (Added Gray for inactive)
            const colors = {
                'blue': { bg: 'bg-blue-500', text: 'text-blue-400', border: 'border-blue-500/20', badgeBg: 'bg-blue-500/10' },
                'cranberry': { bg: 'bg-rota-cranberry', text: 'text-rota-cranberry', border: 'border-rota-cranberry/30', badgeBg: 'bg-rota-cranberry/20' },
                'gold': { bg: 'bg-rota-gold', text: 'text-rota-gold', border: 'border-rota-gold/20', badgeBg: 'bg-rota-gold/10' },
                'cyan': { bg: 'bg-cyan-500', text: 'text-cyan-400', border: 'border-cyan-500/20', badgeBg: 'bg-cyan-500/10' },
                'gray': { bg: 'bg-gray-500', text: 'text-red-400', border: 'border-red-500/20', badgeBg: 'bg-red-500/10' } // The inactive theme
            };
            const theme = colors[data.color];

            // Update content
            document.getElementById('cm-title').innerText = data.title;
            document.getElementById('cm-desc').innerText = data.desc;
            document.getElementById('cm-date').innerText = data.date;
            document.getElementById('cm-focus').innerText = data.focus;
            
            // Update badge text and colors
            const badge = document.getElementById('cm-badge');
            badge.innerText = data.badge;
            badge.className = `inline-block text-[10px] font-extrabold uppercase tracking-widest px-3 py-1 rounded-full mb-3 ${theme.text} ${theme.badgeBg} border ${theme.border}`;
            
            // Update top color strip
            document.getElementById('cm-strip').className = `h-2 w-full ${theme.bg}`;

            // Show modal with animation
            ecoModal.classList.remove('hidden');
            // Slight delay to allow display block to register before animating scale/opacity
            setTimeout(() => {
                ecoModalContent.classList.remove('scale-95', 'opacity-0');
                ecoModalContent.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeClubModal() {
            ecoModalContent.classList.remove('scale-100', 'opacity-100');
            ecoModalContent.classList.add('scale-95', 'opacity-0');
            
            // Wait for transition to finish before hiding
            setTimeout(() => {
                ecoModal.classList.add('hidden');
            }, 300);
        }
    </script>

<!-- SEAMLESS CONTACT FORM LOGIC -->
    <script>
        const contactForm = document.getElementById('contactForm');
        
        if (contactForm) {
            contactForm.addEventListener('submit', async function(event) {
                event.preventDefault(); // Stops the page from redirecting

                const submitBtn = document.getElementById('submitBtn');
                const btnText = document.getElementById('btnText');
                const btnIcon = document.getElementById('btnIcon');
                const successMsg = document.getElementById('formSuccess');
                const errorMsg = document.getElementById('formError');

                // Visual feedback: Change button to "Sending..."
                const originalText = btnText.innerText;
                btnText.innerText = 'Sending...';
                btnIcon.classList.add('hidden');
                submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
                
                // Hide any previous messages
                successMsg.classList.add('hidden');
                errorMsg.classList.add('hidden');

                const formData = new FormData(contactForm);

                try {
                    const response = await fetch(contactForm.action, {
                        method: contactForm.method,
                        body: formData,
                        headers: {
                            'Accept': 'application/json'
                        }
                    });

                    if (response.ok) {
                        // SUCCESS: Clear the form completely
                        contactForm.reset();
                        
                        // Show success message with smooth animation
                        successMsg.classList.remove('hidden');
                        setTimeout(() => {
                            successMsg.classList.remove('translate-y-4', 'opacity-0');
                        }, 10);
                        
                        // Hide the success message after 5 seconds
                        setTimeout(() => {
                            successMsg.classList.add('translate-y-4', 'opacity-0');
                            setTimeout(() => {
                                successMsg.classList.add('hidden');
                            }, 500);
                        }, 5000);
                    } else {
                        // Show error message
                        errorMsg.classList.remove('hidden');
                    }
                } catch (error) {
                    // Show error message
                    errorMsg.classList.remove('hidden');
                } finally {
                    // Reset button back to normal
                    btnText.innerText = originalText;
                    btnIcon.classList.remove('hidden');
                    submitBtn.classList.remove('opacity-75', 'cursor-not-allowed');
                }
            });
        }
    </script>



