    <!-- WELCOME POP-UP JAVASCRIPT -->
    <script>
        // 1. ADD YOUR POP-UP IMAGE LINKS HERE IN THE ORDER YOU WANT THEM TO APPEAR!
        const welcomeImages = <%- JSON.stringify(notices.map(n => n.imageUrl)) %>;

        let currentWelcomeIndex = 0;

        function showNextWelcomeImage() {
            const popModal = document.getElementById('welcome-modal');
            const imgEl = document.getElementById('welcome-popup-img');
            const counterEl = document.getElementById('welcome-counter');
            const actionBtn = document.getElementById('welcome-action-btn');

            if (currentWelcomeIndex < welcomeImages.length) {
                // Set the image source
                imgEl.src = welcomeImages[currentWelcomeIndex];
                imgEl.style.opacity = '1';

                // Update counter text (e.g., "1 / 3")
                counterEl.innerText = `${currentWelcomeIndex + 1} / ${welcomeImages.length}`;
                
                // Change button text based on whether it's the last image
                if (currentWelcomeIndex === welcomeImages.length - 1) {
                    actionBtn.innerText = 'Close';
                } else {
                    actionBtn.innerText = 'Next';
                }

                // Show modal and lock background scrolling
                popModal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                forceCloseWelcome();
            }
        }

        function nextWelcomeImage() {
            const imgEl = document.getElementById('welcome-popup-img');
            
            // Fade out the current image smoothly
            imgEl.style.opacity = '0';

            // Wait for fade-out, then load the next image
            setTimeout(() => {
                currentWelcomeIndex++;
                showNextWelcomeImage();
            }, 300); // 300ms matches the Tailwind duration-300 class
        }
        
        function forceCloseWelcome() {
            const popModal = document.getElementById('welcome-modal');
            popModal.classList.add('hidden');
            document.body.style.overflow = 'auto'; // Restore scrolling
        }

        // Trigger the pop-ups slightly after the page loads
        window.addEventListener('DOMContentLoaded', () => {
            if (welcomeImages.length > 0) {
                // A 1.5-second delay ensures the user sees the beautiful hero section first before the pop-up appears
                setTimeout(() => {
                    showNextWelcomeImage();
                }, 1500); 
            }
        });
    </script>


    <!-- Google Translate Logic -->
    <script type="text/javascript">
    function googleTranslateElementInit() {
      new google.translate.TranslateElement({
          pageLanguage: 'en', 
          includedLanguages: 'ar,zh-CN,en,fr,ru,es,ne,hi',
          autoDisplay: false
      }, 'google_translate_element');
    }

    function doTranslate(langCode, label, event) {
        if(event) event.preventDefault();
        
        // Update custom button text immediately
        const langSpan = document.getElementById('current-lang');
        if(langSpan) langSpan.innerText = label;
        
        // Find Google's hidden select and force the change event
        const selectElement = document.querySelector('.goog-te-combo');
        if (selectElement) {
            selectElement.value = langCode;
            selectElement.dispatchEvent(new Event('change'));
            
            // Sometimes Google Translate needs an extra kick
            setTimeout(() => {
                const e = document.createEvent('HTMLEvents');
                e.initEvent('change', true, true);
                selectElement.dispatchEvent(e);
            }, 100);
        } else {
            console.error("Google Translate combo not found!");
        }
    }
    </script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
